    "schemas": [
      {
        "name": "todo_list",
        "description": "查询当前会话的待办、真实ID、状态及逾期；Plan允许，含完成项，不含已删除项。",
        "parameters": {
          "additionalProperties": false,
          "properties": {},
          "title": "_ListParameters",
          "type": "object"
        }
      },
      {
        "name": "todo_add",
        "description": "按已确认范围记录当前会话待办；需Build及确认。日期接受YYYY-MM-DD或今天/明天/后天；无主动提醒能力。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Title",
              "type": "string"
            },
            "due_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Due Date"
            }
          },
          "required": [
            "title"
          ],
          "title": "_AddParameters",
          "type": "object"
        }
      },
      {
        "name": "todo_update",
        "description": "按真实ID修改已确认的title/due_date。patch省略字段保留原值，due_date=null清除日期；需Build及确认。",
        "parameters": {
          "$defs": {
            "_Patch": {
              "additionalProperties": false,
              "properties": {
                "title": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Title",
                  "type": "string"
                },
                "due_date": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Due Date"
                }
              },
              "title": "_Patch",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            },
            "patch": {
              "$ref": "#/$defs/_Patch"
            }
          },
          "required": [
            "item_id",
            "patch"
          ],
          "title": "_UpdateParameters",
          "type": "object"
        }
      },
      {
        "name": "todo_complete",
        "description": "按已确认的真实ID完成当前会话待办；重复完成changed=false；需Build及确认。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          },
          "required": [
            "item_id"
          ],
          "title": "_IdParameters",
          "type": "object"
        }
      },
      {
        "name": "todo_delete",
        "description": "按已确认的真实ID逻辑删除当前会话待办；普通查询隐藏，重复删除changed=false；需Build及确认。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          },
          "required": [
            "item_id"
          ],
          "title": "_IdParameters",
          "type": "object"
        }
      },
      {
        "name": "calculator",
        "description": "需要确定性数值计算时使用。支持普通十进制数字、+ - * /、括号和一元正负号；不支持幂、函数、变量、科学计数法或代码执行。输入最多512字符、128个语法树节点；非零数值数量级指数为-100到100。数字读取和每步运算按28位有效数字、恰好一半取偶数舍入，返回十进制字符串；除零、语法或资源越界报错。示例：(1+2)*3 返回9，0.1+0.2 返回0.3。",
        "parameters": {
          "additionalProperties": false,
          "description": "公开参数约束，也用于生成模型可见的 JSON Schema。",
          "properties": {
            "expression": {
              "description": "仅包含普通十进制数字、四则运算、括号及一元正负号的表达式。",
              "maxLength": 512,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Expression",
              "type": "string"
            }
          },
          "required": [
            "expression"
          ],
          "title": "CalculatorArguments",
          "type": "object"
        }
      },
      {
        "name": "reminder_list",
        "description": "查询当前会话的单次提醒及状态；Plan可用。",
        "parameters": {
          "additionalProperties": false,
          "properties": {},
          "title": "ListReminders",
          "type": "object"
        }
      },
      {
        "name": "reminder_add",
        "description": "用户需要到点通知时使用；须明确带偏移的ISO时刻、时区、Build和已确认范围。只有日期时先澄清，不默认早上9点。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "scheduled_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Scheduled At"
            },
            "time_zone": {
              "default": "Asia/Shanghai",
              "title": "Time Zone",
              "type": "string"
            },
            "todo_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Todo Id"
            }
          },
          "required": [
            "title"
          ],
          "title": "AddReminder",
          "type": "object"
        }
      },
      {
        "name": "reminder_update",
        "description": "按真实提醒ID修改尚未触发的提醒，须Build和精确确认；不随todo日期隐式修改。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "reminder_id": {
              "title": "Reminder Id",
              "type": "string"
            },
            "patch": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Patch",
              "type": "object"
            }
          },
          "required": [
            "reminder_id",
            "patch"
          ],
          "title": "UpdateReminder",
          "type": "object"
        }
      },
      {
        "name": "reminder_cancel",
        "description": "按真实ID取消当前会话未触发提醒，须Build和确认；重复取消不产生新副作用。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "reminder_id": {
              "title": "Reminder Id",
              "type": "string"
            }
          },
          "required": [
            "reminder_id"
          ],
          "title": "ReminderId",
          "type": "object"
        }
      },
      {
        "name": "propose_goal",
        "description": "记录候选目标/约束/完成标准和精确动作清单供用户确认；不授权业务写入，不切换Build。普通聊天不必调用。",
        "parameters": {
          "$defs": {
            "ActionSpec": {
              "additionalProperties": false,
              "description": "可信执行入口提供的规范化请求，不能凭标签扩大参数或资源。",
              "properties": {
                "operation": {
                  "enum": [
                    "todo.list",
                    "todo.add",
                    "todo.update",
                    "todo.complete",
                    "todo.delete",
                    "reminder.list",
                    "reminder.add",
                    "reminder.update",
                    "reminder.cancel"
                  ],
                  "title": "Operation",
                  "type": "string"
                },
                "parameters": {
                  "additionalProperties": {
                    "$ref": "#/$defs/JsonValue"
                  },
                  "title": "Parameters",
                  "type": "object"
                }
              },
              "required": [
                "operation"
              ],
              "title": "ActionSpec",
              "type": "object"
            },
            "JsonValue": {}
          },
          "additionalProperties": false,
          "properties": {
            "objective": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Objective",
              "type": "string"
            },
            "constraints": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Constraints",
              "type": "array"
            },
            "completion_criteria": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "minItems": 1,
              "title": "Completion Criteria",
              "type": "array"
            },
            "actions": {
              "items": {
                "$ref": "#/$defs/ActionSpec"
              },
              "maxItems": 50,
              "title": "Actions",
              "type": "array"
            }
          },
          "required": [
            "objective",
            "completion_criteria"
          ],
          "title": "GoalParameters",
          "type": "object"
        }
      },
      {
        "name": "read_artifact",
        "description": "按当前会话真实引用和范围补读原文；不能输入磁盘路径或其他会话ID。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "title": "Artifact Id",
              "type": "string"
            },
            "start": {
              "default": 0,
              "minimum": 0,
              "title": "Start",
              "type": "integer"
            },
            "limit": {
              "default": 4000,
              "maximum": 8000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          "required": [
            "artifact_id"
          ],
          "title": "_Reference",
          "type": "object"
        }
      },
      {
        "name": "recall_memory",
        "description": "当追问过去的要求、修改经过或工具执行时，检索当前会话独立归档及结构化事件；source可供read_memory_source核对，历史文字不代表当前业务状态，不跨会话、不授权执行。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Question",
              "type": "string"
            }
          },
          "required": [
            "question"
          ],
          "title": "_Question",
          "type": "object"
        }
      },
      {
        "name": "read_memory_source",
        "description": "当需要核对历史事件原文、否定、条件或参数时，提供recall_memory返回的source；按offset/limit分页，不接受磁盘路径或任意会话ID。引用校验不等于摘要语义正确。",
        "parameters": {
          "$defs": {
            "SourceReference": {
              "additionalProperties": false,
              "description": "引用只是读取线索，既不证明摘要正确，也不授予写权限。",
              "properties": {
