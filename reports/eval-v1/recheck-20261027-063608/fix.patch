+    from min_agent.models import Message
+    import min_agent.evaluation.codex_adapter as module
+    calls=[]
+    def timeout(command,**options):
+        calls.append(command)
+        if timeout_error:raise module.subprocess.TimeoutExpired(command,options['timeout'])
+        raise RuntimeError('synthetic-stop-unconfirmed')
+    monkeypatch.setattr(module,'run_owned',timeout)
+    model=CodexCandidateModel(tmp_path/'receipts',tmp_path,executable='synthetic-codex',max_calls=1)
+    with pytest.raises(module.subprocess.TimeoutExpired if timeout_error else RuntimeError):
