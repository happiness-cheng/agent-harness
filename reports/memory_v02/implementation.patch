+    with args.report.open('xb') as stream:
+        stream.write(gzip.compress((json.dumps(result,ensure_ascii=False,indent=2)+'\n').encode(),mtime=0))
+    print(json.dumps(summaries,ensure_ascii=False,indent=2))
+
+
+if __name__ == '__main__':
+    main()
